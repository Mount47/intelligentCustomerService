{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SupportFlow API（Thread + Stub）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DATABASE_URL": "sqlite:///./local.db",
        "AGENT_DISPATCH": "thread",
        "LLM_PROVIDER": "stub"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Agent Loop 工具调用测试",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_agent_loop.py::test_loop_executes_tool_and_feeds_back",
        "-s",
        "-vv"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "LLM_PROVIDER": "stub"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "调试当前测试文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-s",
        "-vv"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
