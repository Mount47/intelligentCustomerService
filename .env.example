# ===== 应用 =====
APP_NAME=SupportFlow
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ===== 数据库 / Redis（compose 内主机名为 db / redis）=====
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@db:5432/supportflow
REDIS_URL=redis://redis:6379/0

# ===== Celery（默认复用 Redis）=====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== LLM（provider 可插拔，模型名不写死在代码里）=====
LLM_PROVIDER=claude            # claude | openai_compat | ...
LLM_MODEL=claude-opus-4-8      # 切模型只改这里，不动代码
ANTHROPIC_API_KEY=
# OpenAI 兼容（Qwen/DeepSeek/本地 vLLM）按需填
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== 业务阈值（配置化，不写死）=====
REFUND_HIGH_AMOUNT_THRESHOLD=500     # 高金额退款需人工确认
REFUND_RETURN_WINDOW_DAYS=7          # 售后期（已签收超过则不自动退款）
LOGISTICS_STALE_HOURS=48             # 物流无更新阈值（催件）

# ===== SLA（小时）=====
SLA_DEFAULT_HOURS=24
SLA_HIGH_PRIORITY_HOURS=4
