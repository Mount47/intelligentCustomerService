# ===== 应用 =====
APP_NAME=SupportFlow
APP_ENV=local
SUPPORTFLOW_DEBUG=true
LOG_LEVEL=INFO

# ===== 认证 / RBAC =====
# 生产必须替换；用于签发与校验 Bearer Token。
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=3600

# ===== 数据库 / Redis（compose 内主机名为 db / redis）=====
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@db:5432/supportflow
REDIS_URL=redis://redis:6379/0

# ===== Celery（默认复用 Redis）=====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== LLM（provider 可插拔，模型名不写死在代码里，ADR-11）=====
# 切模型/厂商只改下面这几行，不动代码：
LLM_PROVIDER=claude            # claude | openai_compat | deepseek | qwen | gpt | vllm | ollama | stub
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=16000
LLM_THINKING=adaptive          # adaptive | off（仅 Claude 4.x）

# Claude（LLM_PROVIDER=claude）
ANTHROPIC_API_KEY=

# OpenAI 兼容族（GPT / DeepSeek / Qwen / 本地 vLLM·Ollama 都走这套）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 示例：
#  DeepSeek → LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat        OPENAI_BASE_URL=https://api.deepseek.com/v1
#  Qwen     → LLM_PROVIDER=qwen      LLM_MODEL=qwen-plus            OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#  本地vLLM → LLM_PROVIDER=vllm      LLM_MODEL=Qwen2.5-7B-Instruct  OPENAI_BASE_URL=http://localhost:8000/v1

# ===== 业务阈值（配置化，不写死）=====
REFUND_HIGH_AMOUNT_THRESHOLD=500     # 高金额退款需人工确认
REFUND_RETURN_WINDOW_DAYS=7          # 售后期（已签收超过则不自动退款）
LOGISTICS_STALE_HOURS=48             # 物流无更新阈值（催件）

# ===== SLA（小时）=====
SLA_DEFAULT_HOURS=24
SLA_HIGH_PRIORITY_HOURS=4

# ===== 审计 =====
AUDIT_RETENTION_DAYS=90

# ===== 可观测（可选 OTLP；留空则只暴露 /metrics）=====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=supportflow-api
